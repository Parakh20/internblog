# Copy to .env and fill in. Never commit .env.

# Blog to monitor
BLOG_BASE_URL=https://campus.placements.iitb.ac.in/blog/internship

# Polling
POLL_INTERVAL_MINUTES=5

# Database. SQLite default for local dev; Postgres for deployment, e.g.
# DATABASE_URL=postgresql+psycopg2://internblog:CHANGE_ME@db:5432/internblog
# DATABASE_URL=sqlite:///data/internblog.db

# LLM for extraction: any OpenAI-compatible API.
# OpenRouter (default): LLM_BASE_URL=https://openrouter.ai/api/v1
# Groq:                 LLM_BASE_URL=https://api.groq.com/openai/v1
#                       LLM_MODEL=llama-3.3-70b-versatile
# The key is read from LLM_API_KEY, OPENROUTER_API_KEY, or GROQ_API_KEY.
LLM_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-120b:free
EXTRACTION_ENABLED=true

# API server
API_HOST=127.0.0.1
API_PORT=8000
