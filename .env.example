# Copy to .env and fill in. Never commit .env.

# Blog to monitor
BLOG_BASE_URL=https://campus.placements.iitb.ac.in/blog/internship

# Polling
POLL_INTERVAL_MINUTES=5

# Database. SQLite default for local dev; Postgres for deployment, e.g.
# DATABASE_URL=postgresql+psycopg2://internblog:CHANGE_ME@db:5432/internblog
# DATABASE_URL=sqlite:///data/internblog.db

# LLM for extraction: Groq's own free tier is tried first (published rate
# limits, not secondhand capacity), then falls back through a chain of
# OpenRouter free models if Groq is unset or unavailable.
GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter fallback chain (optional, comma-separated model list):
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODELS=openai/gpt-oss-20b:free,qwen/qwen3-next-80b-a3b-instruct:free
EXTRACTION_ENABLED=true

# Telegram push notification for each new job posting extracted. The bot
# token is global; each signed-in user connects their own chat via the
# /start deep link on /settings (no manual chat-id lookup needed).
# Create a bot via @BotFather to get a token and its @username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Shared secret Telegram echoes back on every webhook call. Pick any long
# random string, then register it with Telegram (one-time, from wherever
# curl can reach api.telegram.org):
#   curl -F "url=https://your-hostname.duckdns.org/telegram/webhook" \
#        -F "secret_token=<same value as below>" \
#        https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook
TELEGRAM_WEBHOOK_SECRET=

# ICS calendar feed of deadlines, served at /calendar/{token}.ics.
# Subscribe to this URL in Google Calendar ("From URL") the same way
# Codeforces publishes a contest feed. Pick any long random string.
CALENDAR_FEED_TOKEN=

# Fernet key used to encrypt each signed-in user's Google Calendar refresh
# token at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# OAuth client for "Sign in with Google" + Calendar API access (same
# Cloud project as before, now used for public login too). Create an OAuth
# "Web application" client with an authorized redirect URI of
# <OAUTH_REDIRECT_BASE_URL>/auth/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=https://your-hostname.duckdns.org
# Admin (/admin) and contact address shown on /privacy and /terms.
OWNER_EMAIL=you@example.com

# API server
API_HOST=127.0.0.1
API_PORT=8000
