# Copy to .env and fill in. Never commit .env.

# Blog to monitor
BLOG_BASE_URL=https://campus.placements.iitb.ac.in/blog/internship

# Polling
POLL_INTERVAL_MINUTES=5

# Database. SQLite default for local dev; Postgres for deployment, e.g.
# DATABASE_URL=postgresql+psycopg2://internblog:CHANGE_ME@db:5432/internblog
# DATABASE_URL=sqlite:///data/internblog.db

# LLM for extraction: Groq's own free tier is tried first (published rate
# limits, not secondhand capacity), then falls back through a chain of
# OpenRouter free models if Groq is unset or unavailable.
GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter fallback chain (optional, comma-separated model list):
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODELS=openai/gpt-oss-20b:free,qwen/qwen3-next-80b-a3b-instruct:free
EXTRACTION_ENABLED=true

# Telegram push notification for each new job posting extracted.
# Create a bot via @BotFather to get a token, and message the bot once so
# you can read your chat_id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ICS calendar feed of deadlines, served at /calendar/{token}.ics.
# Subscribe to this URL in Google Calendar ("From URL") the same way
# Codeforces publishes a contest feed. Pick any long random string.
CALENDAR_FEED_TOKEN=

# Direct push into a personal Google Calendar (in addition to the ICS feed
# above), since the Google Calendar mobile app doesn't surface URL-subscribed
# "Other calendars" the way desktop does. One-time setup:
#   python scripts/google_calendar_auth.py <client_id> <client_secret>
# (client_id/secret come from a Google Cloud project with the Calendar API
# enabled and an OAuth "Desktop app" client - see docs/deployment.md)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# API server
API_HOST=127.0.0.1
API_PORT=8000
